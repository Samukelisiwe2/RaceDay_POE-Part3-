@model List<RaceDay.Part3.Models.MyEnrolmentViewModel>

@{
    ViewData["Title"] = "My Registrations";
}

<div class="container py-5">

    <a asp-controller="Participant"
       asp-action="Index"
       class="text-decoration-none">
        ← Back to Dashboard
    </a>

    <h1 class="fw-bold mt-4">My Registrations</h1>

    <p class="text-muted mb-4">
        View and track the races you have entered.
    </p>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="status">

            <strong>Success!</strong>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- ERROR MESSAGE -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning" role="alert">
            @ViewBag.Error
        </div>
    }
    else if (Model == null || Model.Count == 0)
    {
        <!-- NO REGISTRATIONS -->
        <div class="card shadow-sm">
            <div class="card-body text-center p-5">

                <h2 class="h5 fw-bold">
                    No Registrations Yet
                </h2>

                <p class="text-muted">
                    You haven't entered any races yet.
                    Explore available events and join a race.
                </p>

                <a asp-controller="Events"
                   asp-action="Index"
                   class="btn btn-primary">
                    Browse Events
                </a>

            </div>
        </div>
    }
    else
    {
        <!-- REGISTRATION CARDS -->
        <div class="row g-4">

            @foreach (var registration in Model)
            {
                var statusClass =
                    registration.EnrollmentStatus == "Confirmed"
                        ? "bg-success"
                        : registration.EnrollmentStatus == "Pending"
                            ? "bg-warning text-dark"
                            : registration.EnrollmentStatus == "Cancelled"
                                ? "bg-danger"
                                : "bg-secondary";

                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between
                                align-items-start gap-2 mb-3">

                                <h2 class="h5 fw-bold mb-0">
                                    @registration.EventName
                                </h2>

                                <span class="badge @statusClass">
                                    @registration.EnrollmentStatus
                                </span>
                            </div>

                            <p>
                                <strong>Category:</strong>
                                @registration.CategoryName
                            </p>

                            <p>
                                <strong>Race Number:</strong>
                                @registration.RaceNumber
                            </p>

                            <p>
                                <strong>Registration Date:</strong>
                                @registration.EnrollmentDate.ToString("dd MMM yyyy")
                            </p>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@registration.EventId"
                               class="btn btn-outline-primary mt-2">
                                View Event
                            </a>

                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>
