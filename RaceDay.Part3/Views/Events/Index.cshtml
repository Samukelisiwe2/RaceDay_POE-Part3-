@model List<RaceDay.Part3.Models.Events.EventViewModel>

@{
    ViewData["Title"] = "Race Events";
}

<div class="container py-5">

    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center
        gap-3 mb-4">

        <div>
            <h1 class="display-6 fw-bold">
                RaceDay Events
            </h1>

            <p class="text-muted">
                Discover and manage sporting events.
            </p>
        </div>

        @if (User.IsInRole("Organiser"))
        {
            <a asp-controller="Organiser"
               asp-action="CreateEvent"
               class="btn btn-primary">
                + Create Event
            </a>
        }
    </div>

   
    <!-- EVENT SEARCH AND FILTERS -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h2 class="h5 fw-bold mb-3">
                Find a Race
            </h2>

            <form asp-controller="Events"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-md-4">
                        <label for="search"
                               class="form-label">
                            Search Events
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Event name or location" />
                    </div>

                    <!-- Event Type -->
                    <div class="col-md-3">
                        <label for="eventType"
                               class="form-label">
                            Race Type
                        </label>

                        <select id="eventType"
                                name="eventType"
                                class="form-select">

                            <option value="">
                                All Types
                            </option>

                            <option value="Run"
                                    selected="@(ViewBag.EventType == "Run")">
                                Running
                            </option>

                            <option value="Walk"
                                    selected="@(ViewBag.EventType == "Walk")">
                                Walking
                            </option>

                            <option value="Cycle"
                                    selected="@(ViewBag.EventType == "Cycle")">
                                Cycling
                            </option>
                        </select>
                    </div>

                    <!-- Event Status -->
                    <div class="col-md-3">
                        <label for="status"
                               class="form-label">
                            Status
                        </label>

                        <select id="status"
                                name="status"
                                class="form-select">

                            <option value="">
                                All Statuses
                            </option>

                            @foreach (var statusOption in new[]
                            {
                            "Planned",
                            "Open",
                            "Closed",
                            "Completed",
                            "Cancelled"
                        })
                            {
                                <option value="@statusOption"
                                        selected="@(ViewBag.Status == statusOption)">
                                    @statusOption
                                </option>
                            }

                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="col-md-2 d-flex align-items-end">
                        <div class="d-flex gap-2 flex-wrap">

                            <button type="submit"
                                    class="btn btn-primary">
                                Search
                            </button>

                            <a asp-controller="Events"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Clear
                            </a>

                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

        <div class="alert alert-success" role="status">
            @TempData["Success"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.Error
        </div>
    }
    else if (Model == null || Model.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">

                <h2 class="h5">No Events Available</h2>

                <p class="text-muted">
                    No sporting events have been
                    created yet.
                </p>

                @if (User.IsInRole("Organiser"))
                {
                    <a asp-controller="Organiser"
                       asp-action="CreateEvent"
                       class="btn btn-primary">
                        Create Your First Event
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var raceEvent in Model)
            {
                var statusClass =
                    raceEvent.Status == "Open"
                        ? "bg-success"
                        : raceEvent.Status == "Planned"
                            ? "bg-primary"
                            : raceEvent.Status == "Cancelled"
                                ? "bg-danger"
                                : "bg-secondary";

                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">

                        <div class="card-body p-4">

                            <div class="d-flex
                                justify-content-between
                                align-items-start gap-2 mb-3">

                                <h2 class="h5 fw-bold mb-0">
                                    @raceEvent.EventName
                                </h2>

                                <span class="badge @statusClass">
                                    @raceEvent.Status
                                </span>
                            </div>

                            <p class="text-muted">
                                @raceEvent.Description
                            </p>

                            <hr />

                            <p>
                                <strong>Date:</strong>
                                @raceEvent.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @raceEvent.Location
                            </p>

                            <p>
                                <strong>Type:</strong>
                                @raceEvent.EventType
                            </p>

                            <p>
                                <strong>Registration Closes:</strong>
                                @raceEvent.ClosingDate.ToString("dd MMM yyyy")
                            </p>

                            <div class="d-flex flex-wrap gap-2 mt-3">

                                <a asp-controller="Events"
                                   asp-action="Details"
                                   asp-route-id="@raceEvent.EventId"
                                   class="btn btn-outline-primary">
                                    View Details
                                </a>

                                @if (User.IsInRole("Organiser"))
                                {
                                    <a asp-controller="Organiser"
                                       asp-action="EditEvent"
                                       asp-route-id="@raceEvent.EventId"
                                       class="btn btn-primary">
                                        Edit Event
                                    </a>
                                }

                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>
