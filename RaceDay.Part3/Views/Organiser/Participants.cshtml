@model List<RaceDay.Part3.Models.EventEnrolmentViewModel>

@{
    ViewData["Title"] = "Enrolled Participants";

    int eventId = (int)ViewBag.EventId;

    var resultLookup =
        ViewBag.ResultLookup as Dictionary<int, int>
        ?? new Dictionary<int, int>();

    int participantCount = Model?.Count ?? 0;
    int recordedCount = Model?
        .Count(p => resultLookup.ContainsKey(p.EnrollmentId)) ?? 0;
}

<div class="container py-5">

    <!-- BACK NAVIGATION -->
    <a asp-controller="Events"
       asp-action="Details"
       asp-route-id="@eventId"
       class="text-decoration-none">
        ← Back to Event
    </a>

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between
        align-items-center gap-3 mt-4 mb-4">

        <div>
            <h1 class="fw-bold mb-2">
                Enrolled Participants
            </h1>

            <p class="text-muted mb-0">
                @ViewBag.EventName
            </p>
        </div>

        <span class="badge bg-primary fs-6 p-3">
            @participantCount Registered
        </span>
    </div>

    <!-- MANAGEMENT LINKS -->
    <div class="d-flex flex-wrap gap-2 mb-4">

        <a asp-controller="Organiser"
           asp-action="EventResults"
           asp-route-id="@eventId"
           class="btn btn-primary">
            View / Edit Race Results
        </a>

        <a asp-controller="Organiser"
           asp-action="Categories"
           asp-route-id="@eventId"
           class="btn btn-outline-primary">
            Manage Categories
        </a>

        <a asp-controller="Events"
           asp-action="Details"
           asp-route-id="@eventId"
           class="btn btn-outline-secondary">
            Event Details
        </a>

    </div>

    <!-- SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-3">

                    <p class="text-muted mb-1">
                        Total Enrolments
                    </p>

                    <h2 class="fw-bold mb-0">
                        @participantCount
                    </h2>

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-3">

                    <p class="text-muted mb-1">
                        Results Recorded
                    </p>

                    <h2 class="fw-bold mb-0">
                        @recordedCount
                    </h2>

                </div>
            </div>
        </div>

    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success"
             role="status">
            @TempData["Success"]
        </div>
    }

    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"
             role="alert">
            @TempData["Error"]
        </div>
    }

    <!-- EMPTY STATE -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body p-5 text-center">

                <h2 class="h5 fw-bold">
                    No Participants Yet
                </h2>

                <p class="text-muted">
                    Nobody has registered for this event yet.
                </p>

                <a asp-controller="Events"
                   asp-action="Details"
                   asp-route-id="@eventId"
                   class="btn btn-outline-primary">
                    View Event Details
                </a>

            </div>
        </div>
    }
    else
    {
        <!-- PARTICIPANT TABLE -->
        <div class="card shadow-sm">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">
                                Participant
                            </th>

                            <th scope="col">
                                Category
                            </th>

                            <th scope="col">
                                Race Number
                            </th>

                            <th scope="col">
                                Enrolment Status
                            </th>

                            <th scope="col">
                                Result
                            </th>

                            <th scope="col">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var participant in Model)
                        {
                            bool isCancelled =
                                participant.EnrollmentStatus == "Cancelled";

                            bool hasResult =
                                resultLookup.TryGetValue(
                                    participant.EnrollmentId,
                                    out int existingResultId);

                            string badgeClass =
                                participant.EnrollmentStatus == "Confirmed"
                                    ? "bg-success"
                                    : participant.EnrollmentStatus == "Pending"
                                        ? "bg-warning text-dark"
                                        : isCancelled
                                            ? "bg-danger"
                                            : "bg-secondary";

                            <tr>

                                <td class="ps-4">
                                    <strong>
                                        @participant.FullName
                                    </strong>
                                </td>

                                <td>
                                    @participant.CategoryName
                                </td>

                                <td>
                                    @participant.RaceNumber
                                </td>

                                <td>
                                    <span class="badge @badgeClass">
                                        @participant.EnrollmentStatus
                                    </span>
                                </td>

                                <td>
                                    @if (hasResult)
                                    {
                                        <span class="badge bg-success">
                                            Recorded
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Not Recorded
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (isCancelled)
                                    {
                                        <span class="text-muted small">
                                            Entry Cancelled
                                        </span>
                                    }
                                    else if (hasResult)
                                    {
                                        <a asp-controller="Organiser"
                                           asp-action="EditResult"
                                           asp-route-eventId="@eventId"
                                           asp-route-resultId="@existingResultId"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit Result
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Organiser"
                                           asp-action="CaptureResult"
                                           asp-route-eventId="@eventId"
                                           asp-route-enrollmentId="@participant.EnrollmentId"
                                           class="btn btn-sm btn-primary">
                                            Record Result
                                        </a>
                                    }
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>

        <div class="alert alert-info mt-4">
            <strong>Result Management</strong>

            <p class="mb-0 mt-2">
                Participants without results can have their
                first result recorded. Existing results can
                be edited. Completed results cannot be saved
                before the event date.
            </p>
        </div>
    }

</div>
