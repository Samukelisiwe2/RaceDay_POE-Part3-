@model List<RaceDay.Part3.Models.EventEnrolmentViewModel>

@{
    ViewData["Title"] = "Enrolled Participants";

    int eventId = (int)ViewBag.EventId;
}

<div class="container py-5">

    <!-- BACK TO EVENT -->
    <a asp-controller="Events"
       asp-action="Details"
       asp-route-id="@eventId"
       class="text-decoration-none">
        ← Back to Event
    </a>

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between
        align-items-center gap-3 mt-4 mb-4">

        <div>
            <h1 class="fw-bold mb-2">
                Enrolled Participants
            </h1>

            <p class="text-muted mb-0">
                @ViewBag.EventName
            </p>
        </div>

        <span class="badge bg-primary fs-6 p-3">
            @Model.Count Registered
        </span>

    </div>

    <!-- RESULT MANAGEMENT NAVIGATION -->
    <div class="d-flex flex-wrap gap-2 mb-4">

        <a asp-controller="Organiser"
           asp-action="EventResults"
           asp-route-id="@eventId"
           class="btn btn-primary">
            View / Edit Race Results
        </a>

        <a asp-controller="Organiser"
           asp-action="Categories"
           asp-route-id="@eventId"
           class="btn btn-outline-primary">
            Manage Categories
        </a>

        <a asp-controller="Events"
           asp-action="Details"
           asp-route-id="@eventId"
           class="btn btn-outline-secondary">
            Event Details
        </a>

    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success
            alert-dismissible fade show"
             role="status">

            <strong>Success!</strong>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger
            alert-dismissible fade show"
             role="alert">

            <strong>Error!</strong>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- NO PARTICIPANTS -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="card shadow-sm">

            <div class="card-body p-5 text-center">

                <h2 class="h5 fw-bold">
                    No Participants Yet
                </h2>

                <p class="text-muted">
                    No participants have registered
                    for this race yet.
                </p>

                <a asp-controller="Events"
                   asp-action="Details"
                   asp-route-id="@eventId"
                   class="btn btn-outline-primary">
                    View Event Details
                </a>

            </div>
        </div>
    }
    else
    {
        <!-- PARTICIPANTS TABLE -->
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover
                        align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th scope="col" class="ps-4">
                                    Participant
                                </th>

                                <th scope="col">
                                    Category
                                </th>

                                <th scope="col">
                                    Race Number
                                </th>

                                <th scope="col">
                                    Status
                                </th>

                                <th scope="col">
                                    Actions
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var participant in Model)
                            {
                                var badgeClass =
                                    participant.EnrollmentStatus == "Confirmed"
                                        ? "bg-success"
                                        : participant.EnrollmentStatus == "Pending"
                                            ? "bg-warning text-dark"
                                            : participant.EnrollmentStatus == "Cancelled"
                                                ? "bg-danger"
                                                : "bg-secondary";

                                <tr>

                                    <!-- PARTICIPANT NAME -->
                                    <td class="ps-4">

                                        <strong>
                                            @participant.FullName
                                        </strong>

                                    </td>

                                    <!-- CATEGORY -->
                                    <td>
                                        @participant.CategoryName
                                    </td>

                                    <!-- RACE NUMBER -->
                                    <td>
                                        @participant.RaceNumber
                                    </td>

                                    <!-- ENROLMENT STATUS -->
                                    <td>

                                        <span class="badge @badgeClass">
                                            @participant.EnrollmentStatus
                                        </span>

                                    </td>

                                    <!-- RESULT ACTION -->
                                    <td>

                                        @if (participant.EnrollmentStatus != "Cancelled")
                                        {
                                            <a asp-controller="Organiser"
                                               asp-action="CaptureResult"
                                               asp-route-eventId="@eventId"
                                               asp-route-enrollmentId="@participant.EnrollmentId"
                                               class="btn btn-sm btn-primary">
                                                Record Result
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                Entry Cancelled
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- RESULT INFORMATION -->
        <div class="alert alert-info mt-4"
             role="note">

            <strong>Result Management</strong>

            <p class="mb-0 mt-2">
                Use Record Result to capture a participant's
                first race result. If a result already exists,
                select View / Edit Race Results instead.
                A Completed result requires a valid start time,
                finish time and overall position, and the race
                must have taken place.
            </p>

        </div>
    }

</div>
