@model RaceDay.Part3.Models.ResultEntryViewModel

@{
    ViewData["Title"] = "Record Race Result";

    bool raceHasTakenPlace =
        ViewBag.RaceHasTakenPlace is bool value && value;

    DateTime? eventDate =
        ViewBag.EventDate is DateTime date
            ? date
            : null;
}

<div class="container py-5">

    <a asp-controller="Organiser"
       asp-action="Participants"
       asp-route-id="@Model.EventId"
       class="text-decoration-none">
        ← Back to Participants
    </a>

    <h1 class="fw-bold mt-4">
        Record Race Result
    </h1>

    <p class="text-muted">
        @ViewBag.EventName
    </p>

    @if (eventDate.HasValue)
    {
        <p>
            <strong>Race Date:</strong>
            @eventDate.Value.ToString("dd MMMM yyyy")
        </p>
    }

    @if (!raceHasTakenPlace)
    {
        <div class="alert alert-warning"
             role="status">
            <strong>Race Not Yet Completed</strong>

            <p class="mb-0 mt-2">
                This event has not taken place yet.
                Completed results cannot be recorded
                before race day.
            </p>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">

            @if (ViewBag.ParticipantName != null)
            {
                <div class="alert alert-info">

                    <strong>Participant:</strong>
                    @ViewBag.ParticipantName

                    <div>
                        <strong>Category:</strong>
                        @ViewBag.CategoryName
                    </div>

                    <div>
                        <strong>Race Number:</strong>
                        @ViewBag.RaceNumber
                    </div>
                </div>
            }

            <form asp-controller="Organiser"
                  asp-action="CaptureResult"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="EventId"
                       type="hidden" />

                <input asp-for="EnrollmentId"
                       type="hidden" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ResultStatus"
                           class="form-label"></label>

                    <select asp-for="ResultStatus"
                            class="form-select">

                        <option value="Pending">
                            Pending
                        </option>

                        <option value="Completed"
                                disabled="@(!raceHasTakenPlace)">
                            Completed
                        </option>

                        <option value="Did Not Finish">
                            Did Not Finish
                        </option>

                        <option value="Disqualified">
                            Disqualified
                        </option>

                    </select>

                    <span asp-validation-for="ResultStatus"
                          class="text-danger"></span>
                </div>

                <h2 class="h5 mt-4">
                    Race Performance
                </h2>

                <p class="text-muted small">
                    For Completed results, start time,
                    finish time and overall position
                    are required.
                </p>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="StartTime"
                               class="form-label"></label>

                        <input asp-for="StartTime"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="StartTime"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FinishTime"
                               class="form-label"></label>

                        <input asp-for="FinishTime"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="FinishTime"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="OverallPosition"
                               class="form-label"></label>

                        <input asp-for="OverallPosition"
                               type="number"
                               min="1"
                               class="form-control" />

                        <span asp-validation-for="OverallPosition"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Result
                    </button>

                    <a asp-controller="Organiser"
                       asp-action="Participants"
                       asp-route-id="@Model.EventId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
