@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-5">

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <strong>Success!</strong>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <strong>Error!</strong>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- DASHBOARD HEADER -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center
        gap-3 mb-4">

        <div>
            <h1 class="display-6 fw-bold mb-2">
                Organiser Dashboard
            </h1>

            <p class="text-muted mb-3">
                Welcome to RaceDay.
                Manage your events from one place.
            </p>

            <a asp-controller="Organiser"
               asp-action="Profile"
               class="btn btn-outline-primary">
                View / Edit Organiser Profile
            </a>
        </div>

        <span class="badge bg-primary fs-6 p-3">
            Organiser
        </span>
    </div>

    <!-- DASHBOARD CARDS -->
    <div class="row g-4 mb-5">

        <!-- MY EVENTS -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4">

                    <h2 class="h5 fw-bold">
                        My Events
                    </h2>

                    <p class="text-muted">
                        View and manage the races
                        you organise.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Events
                    </a>

                </div>
            </div>
        </div>

        <!-- CREATE EVENT -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4">

                    <h2 class="h5 fw-bold">
                        Create Event
                    </h2>

                    <p class="text-muted">
                        Create a new running event
                        and manage its details.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="CreateEvent"
                       class="btn btn-primary">
                        Create Event
                    </a>

                </div>
            </div>
        </div>

        <!-- PARTICIPANTS -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4">

                    <h2 class="h5 fw-bold">
                        Participants
                    </h2>

                    <p class="text-muted">
                        Review registrations for
                        your organised races.
                    </p>

                    <span class="badge bg-secondary">
                        Coming Soon
                    </span>

                </div>
            </div>
        </div>

    </div>

    <!-- INFORMATION PANEL -->
    <div class="card border-0 bg-light">
        <div class="card-body p-4">

            <h2 class="h5 fw-bold">
                Organiser Workspace
            </h2>

            <p class="mb-0">
                Create race events, browse existing events
                and update your organiser profile.
                Participant management and additional
                event-management features are being developed.
            </p>

        </div>
    </div>

</div>
