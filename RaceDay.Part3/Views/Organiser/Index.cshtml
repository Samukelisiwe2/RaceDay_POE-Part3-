@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-5">

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success"
             role="status">
            @TempData["Success"]
        </div>
    }

    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"
             role="alert">
            @TempData["Error"]
        </div>
    }

    <!-- HEADER -->
    <div class="d-flex flex-wrap
        justify-content-between
        align-items-center
        gap-3 mb-4">

        <div>
            <h1 class="fw-bold mb-2">
                Organiser Dashboard
            </h1>

            <p class="text-muted mb-0">
                Manage your events, categories,
                participants and race results.
            </p>
        </div>

        <span class="badge bg-primary p-3">
            Organiser
        </span>
    </div>

    <!-- PROFILE -->
    <div class="mb-4">
        <a asp-controller="Organiser"
           asp-action="Profile"
           class="btn btn-outline-primary">
            View / Edit Organiser Profile
        </a>
    </div>

    <!-- MANAGEMENT CARDS -->
    <div class="row g-4">

        <!-- MY EVENTS -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4
                    d-flex flex-column">

                    <h2 class="h5 fw-bold">
                        My Events
                    </h2>

                    <p class="text-muted">
                        Browse race events and open
                        their management pages.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary mt-auto
                        align-self-start">
                        View Events
                    </a>
                </div>
            </div>
        </div>

        <!-- CREATE EVENT -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4
                    d-flex flex-column">

                    <h2 class="h5 fw-bold">
                        Create Event
                    </h2>

                    <p class="text-muted">
                        Add a new race with its
                        location, dates and details.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="CreateEvent"
                       class="btn btn-primary mt-auto
                        align-self-start">
                        Create Event
                    </a>
                </div>
            </div>
        </div>

        <!-- PARTICIPANTS -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4
                    d-flex flex-column">

                    <h2 class="h5 fw-bold">
                        Participants
                    </h2>

                    <p class="text-muted">
                        View enrolled participants,
                        race categories and
                        registration statuses.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary mt-auto
                        align-self-start">
                        Select Event
                    </a>
                </div>
            </div>
        </div>

        <!-- RACE CATEGORIES -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4
                    d-flex flex-column">

                    <h2 class="h5 fw-bold">
                        Race Categories
                    </h2>

                    <p class="text-muted">
                        Manage race distances,
                        entry fees and
                        participant capacity.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-outline-primary
                        mt-auto align-self-start">
                        Select Event
                    </a>
                </div>
            </div>
        </div>

        <!-- RACE RESULTS -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4
                    d-flex flex-column">

                    <h2 class="h5 fw-bold">
                        Race Results
                    </h2>

                    <p class="text-muted">
                        Select an event, view its
                        enrolled participants and
                        record their race results.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-outline-primary
                        mt-auto align-self-start">
                        Select Event
                    </a>
                </div>
            </div>
        </div>

        <!-- ORGANISER PROFILE -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4
                    d-flex flex-column">

                    <h2 class="h5 fw-bold">
                        Organiser Profile
                    </h2>

                    <p class="text-muted">
                        Update your organiser name
                        and contact information.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="Profile"
                       class="btn btn-outline-primary
                        mt-auto align-self-start">
                        Manage Profile
                    </a>
                </div>
            </div>
        </div>

    </div>

    <!-- WORKSPACE INFORMATION -->
    <div class="bg-light rounded p-4 mt-5">

        <h2 class="h5 fw-bold">
            Organiser Workspace
        </h2>

        <p class="text-muted mb-0">
            To manage participants, categories or
            results, first select an event.
            Open its details page and choose
            the required management action.
            These operations use the
            authenticated RaceDay API.
        </p>

    </div>

</div>

