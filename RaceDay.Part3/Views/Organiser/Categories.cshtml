@model List<RaceDay.Part3.Models.RaceCategoryViewModel>

@{
    ViewData["Title"] = "Manage Race Categories";
    int eventId = (int)ViewBag.EventId;
}

<div class="container py-5">

    <a asp-controller="Events"
       asp-action="Details"
       asp-route-id="@eventId"
       class="text-decoration-none">
        ← Back to Event
    </a>

    <div class="mt-4 mb-4">
        <h1 class="fw-bold">Race Categories</h1>
        <p class="text-muted">
            Manage categories for @ViewBag.EventName
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="status">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }

    <!-- CREATE CATEGORY -->
    <div class="card shadow-sm mb-5">
        <div class="card-body p-4">

            <h2 class="h5 fw-bold mb-3">
                Create New Category
            </h2>

            <form asp-controller="Organiser"
                  asp-action="CreateCategory"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="EventId"
                       value="@eventId" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label for="CategoryName"
                               class="form-label">
                            Category Name
                        </label>

                        <input id="CategoryName"
                               name="CategoryName"
                               class="form-control"
                               maxlength="100"
                               placeholder="e.g. 5km Fun Run"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label for="DistanceKm"
                               class="form-label">
                            Distance (km)
                        </label>

                        <input id="DistanceKm"
                               name="DistanceKm"
                               type="number"
                               step="0.01"
                               min="0.01"
                               max="9999.99"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label for="EntryFee"
                               class="form-label">
                            Entry Fee (R)
                        </label>

                        <input id="EntryFee"
                               name="EntryFee"
                               type="number"
                               min="0"
                               max="99999999.99"
                               step="0.01"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label for="MaxParticipants"
                               class="form-label">
                            Maximum Participants
                        </label>

                        <input id="MaxParticipants"
                               name="MaxParticipants"
                               type="number"
                               min="1"
                               step="1"
                               class="form-control"
                               required />
                    </div>

                </div>

                <button type="submit"
                        class="btn btn-primary mt-4">
                    Create Category
                </button>
            </form>
        </div>
    </div>

    <!-- EXISTING CATEGORIES -->
    <h2 class="h4 fw-bold mb-3">
        Existing Categories
    </h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No race categories have been created yet.
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var category in Model)
            {
                bool hasParticipants =
                    category.CurrentParticipants > 0;

                <div class="col-md-6">

                    <div class="card shadow-sm h-100">

                        <div class="card-body p-4">

                            <div class="d-flex
                                justify-content-between
                                align-items-start gap-2">

                                <h3 class="h5 fw-bold">
                                    @category.CategoryName
                                </h3>

                                <span class="badge @(category.IsFull
                                      ? "bg-danger"
                                      : "bg-success")">
                                    @(category.IsFull
                                        ? "Full"
                                        : "Available")
                                </span>

                            </div>

                            <p>
                                <strong>Distance:</strong>
                                @category.DistanceKm.ToString("N2") km
                            </p>

                            <p>
                                <strong>Entry Fee:</strong>
                                R @category.EntryFee.ToString("N2")
                            </p>

                            <p>
                                <strong>Participants:</strong>
                                @category.CurrentParticipants /
                                @category.MaxParticipants
                            </p>

                            <p>
                                <strong>Places Left:</strong>
                                @category.AvailablePlaces
                            </p>

                            <!-- CATEGORY ACTIONS -->
                            <div class="d-flex flex-wrap gap-2 mt-3">

                                <a asp-controller="Organiser"
                                   asp-action="EditCategory"
                                   asp-route-eventId="@eventId"
                                   asp-route-categoryId="@category.CategoryId"
                                   class="btn btn-primary">
                                    Edit Category
                                </a>

                                @if (!hasParticipants)
                                {
                                    <a asp-controller="Organiser"
                                       asp-action="DeleteCategory"
                                       asp-route-eventId="@eventId"
                                       asp-route-categoryId="@category.CategoryId"
                                       class="btn btn-outline-danger">
                                        Delete Category
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-secondary
                                        align-self-center p-2">
                                        Deletion restricted
                                    </span>
                                }

                            </div>

                            @if (hasParticipants)
                            {
                                <p class="text-muted small mt-3 mb-0">
                                    This category has existing
                                    registrations and cannot
                                    be deleted.
                                </p>
                            }

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>
