@model IEnumerable<RaceDay.Models.RaceResult>

@{
    ViewData["Title"] = "Event Results";
    int eventId = (int)ViewBag.EventId;
    bool canManage = ViewBag.CanManage == true;
}

<div class="container mt-4">
    <h1>Event Results</h1>

    <p class="text-muted">@ViewBag.EventName</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No results have been recorded for this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Position</th>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Race Number</th>
                        <th>Start</th>
                        <th>Finish</th>
                        <th>Status</th>

                        @if (canManage)
                        {
                            <th>Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>
                                @(result.OverallPosition?.ToString() ?? "-")
                            </td>
                            <td>
                                @result.Enrollment.Participant.FirstName
                                @result.Enrollment.Participant.LastName
                            </td>
                            <td>
                                @result.Enrollment.RaceCategory.CategoryName
                            </td>
                            <td>@result.Enrollment.RaceNumber</td>
                            <td>
                                @(result.StartTime?.ToString("HH:mm:ss") ?? "-")
                            </td>
                            <td>
                                @(result.FinishTime?.ToString("HH:mm:ss") ?? "-")
                            </td>
                            <td>@result.ResultStatus</td>

                            @if (canManage)
                            {
                                <td>
                                    <a asp-action="Edit"
                                       asp-route-id="@result.ResultId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Events"
       asp-action="Details"
       asp-route-id="@eventId"
       class="btn btn-outline-secondary">
        Back to Event
    </a>
</div>

