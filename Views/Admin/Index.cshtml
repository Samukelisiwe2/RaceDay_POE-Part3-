@model RaceDay.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <h1>RaceDay Admin Dashboard</h1>
    <p class="text-muted">Manage users and view their assigned roles.</p>

    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Total Users</h5>
                <h2>@Model.TotalUsers</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Organisers</h5>
                <h2>@Model.TotalOrganisers</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Participants</h5>
                <h2>@Model.TotalParticipants</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Unassigned Users</h5>
                <h2>@Model.UnassignedUsers</h2>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h4>Registered Users</h4>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Assigned Role</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.Email</td>

                                <td>
                                    @(user.Roles.Count > 0
                                        ? string.Join(", ", user.Roles)
                                        : "Not assigned")
                                </td>

                                <td>
                                    @if (user.Roles.Count > 0)
                                    {
                                        <span class="badge bg-success">
                                            Assigned
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Unassigned
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
