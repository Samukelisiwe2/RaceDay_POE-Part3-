@model IEnumerable<RaceDay.Models.RaceCategory>

@{
    ViewData["Title"] = "Race Categories";
    int eventId = (int)ViewBag.EventId;
    bool canManage = ViewBag.CanManage == true;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Race Categories</h1>
            <p class="text-muted">
                Categories for @ViewBag.EventName
            </p>
        </div>

        @if (canManage)
        {
            <a asp-action="Create"
               asp-route-eventId="@eventId"
               class="btn btn-primary">
                Add Category
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No race categories have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Entry Fee</th>
                        <th>Capacity</th>

                        @if (canManage)
                        {
                            <th>Actions</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryName</td>
                            <td>@category.DistanceKm.ToString("0.##") km</td>
                            <td>
                                R @category.EntryFee.ToString("N2")
                            </td>
                            <td>
                                @category.CurrentParticipants /
                                @category.MaxParticipants
                            </td>

                            @if (canManage)
                            {
                                <td>
                                    <a asp-action="Edit"
                                       asp-route-id="@category.CategoryId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@category.CategoryId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Events"
       asp-action="Details"
       asp-route-id="@eventId"
       class="btn btn-outline-secondary mt-3">
        Back to Event
    </a>
</div>

