@model RaceDay.Models.RaceCategory

@{
    ViewData["Title"] = "Delete Race Category";
}

<div class="container mt-4">

    <h1>Delete Race Category</h1>

    <div class="alert alert-warning mt-3">
        Are you sure you want to delete this category?
        This action cannot be undone.
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h4>@Model.CategoryName</h4>

            <dl class="row mt-3">
                <dt class="col-sm-4">Distance</dt>
                <dd class="col-sm-8">
                    @Model.DistanceKm.ToString("0.##") km
                </dd>

                <dt class="col-sm-4">Entry Fee</dt>
                <dd class="col-sm-8">
                    R @Model.EntryFee.ToString("N2")
                </dd>

                <dt class="col-sm-4">Maximum Participants</dt>
                <dd class="col-sm-8">
                    @Model.MaxParticipants
                </dd>
            </dl>

            <form asp-controller="RaceCategories"
                  asp-action="Delete"
                  asp-route-id="@Model.CategoryId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger">
                    Yes, Delete Category
                </button>

                <a asp-action="Index"
                   asp-route-eventId="@Model.EventId"
                   class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
