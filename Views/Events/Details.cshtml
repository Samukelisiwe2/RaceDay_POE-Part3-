@model RaceDay.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">
    <h1>@Model.EventName</h1>
    <p class="text-muted">@Model.Description</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Organiser</dt>
                <dd class="col-sm-9">
                    @Model.Organiser?.OrganiserName
                </dd>

                <dt class="col-sm-3">Event Date</dt>
                <dd class="col-sm-9">
                    @Model.EventDate.ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-3">Closing Date</dt>
                <dd class="col-sm-9">
                    @Model.ClosingDate.ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@Model.Location</dd>

                <dt class="col-sm-3">Event Type</dt>
                <dd class="col-sm-9">@Model.EventType</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>
        </div>
    </div>

    <h3>Race Categories</h3>

    @if (Model.RaceCategories == null ||
         !Model.RaceCategories.Any())
    {
        <p class="text-muted">
            No race categories have been added yet.
        </p>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Entry Fee</th>
                        <th>Capacity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.RaceCategories)
                    {
                        <tr>
                            <td>@category.CategoryName</td>
                            <td>@category.DistanceKm km</td>
                            <td>
                                @category.EntryFee.ToString("C")
                            </td>
                            <td>
                                @category.CurrentParticipants /
                                @category.MaxParticipants
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (User.IsInRole("Organiser"))
    {
        <div class="d-flex gap-2 mb-3">
            <a asp-action="Edit"
               asp-route-id="@Model.EventId"
               class="btn btn-warning">
                Edit Event
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.EventId"
               class="btn btn-danger">
                Delete Event
            </a>
        </div>
    }

    <a asp-action="Index" class="btn btn-outline-secondary">
        Back to Events
    </a>
</div>

