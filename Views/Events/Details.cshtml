@model RaceDay.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">

    <!-- Event Title -->
    <h1>@Model.EventName</h1>

    <p class="text-muted">
        @Model.Description
    </p>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Event Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4 class="mb-3">Event Information</h4>

            <dl class="row">

                <dt class="col-sm-3">Organiser</dt>
                <dd class="col-sm-9">
                    @Model.Organiser?.OrganiserName
                </dd>

                <dt class="col-sm-3">Event Date</dt>
                <dd class="col-sm-9">
                    @Model.EventDate.ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-3">Closing Date</dt>
                <dd class="col-sm-9">
                    @Model.ClosingDate.ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">
                    @Model.Location
                </dd>

                <dt class="col-sm-3">Event Type</dt>
                <dd class="col-sm-9">
                    @Model.EventType
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-secondary">
                        @Model.Status
                    </span>
                </dd>

            </dl>
        </div>
    </div>

    <!-- Race Categories Section -->
    <div class="d-flex flex-wrap justify-content-between
        align-items-center gap-2 mb-3">

        <h3 class="mb-0">Race Categories</h3>

        <!-- Both roles can view categories -->
        <a asp-controller="RaceCategories"
           asp-action="Index"
           asp-route-eventId="@Model.EventId"
           class="btn btn-outline-primary">
            View Race Categories
        </a>

    </div>

    <!-- Categories Table -->
    @if (Model.RaceCategories == null ||
         !Model.RaceCategories.Any())
    {
        <div class="alert alert-info">
            No race categories have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive mb-4">

            <table class="table table-striped table-hover
                align-middle">

                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Entry Fee</th>
                        <th>Participants</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var category in Model.RaceCategories
                        .OrderBy(c => c.DistanceKm))
                    {
                        <tr>

                            <td>
                                @category.CategoryName
                            </td>

                            <td>
                                @category.DistanceKm.ToString("0.##") km
                            </td>

                            <td>
                                R @category.EntryFee.ToString("N2")
                            </td>

                            <td>
                                @category.CurrentParticipants /
                                @category.MaxParticipants
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <!-- Event Management Buttons -->
    @if (User.IsInRole("Organiser"))
    {
        <div class="d-flex flex-wrap gap-2 mb-3">

            <a asp-controller="Events"
               asp-action="Edit"
               asp-route-id="@Model.EventId"
               class="btn btn-warning">
                Edit Event
            </a>

            <a asp-controller="Events"
               asp-action="Delete"
               asp-route-id="@Model.EventId"
               class="btn btn-danger">
                Delete Event
            </a>

        </div>
    }

    <!-- Back Button -->
    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Events
    </a>

</div>
