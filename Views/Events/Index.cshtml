@model IEnumerable<RaceDay.Models.Event>

@{
    ViewData["Title"] = "Race Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Race Events</h1>
            <p class="text-muted">
                Browse running, walking and cycling events.
            </p>
        </div>

        @if (User.IsInRole("Organiser"))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                Create Event
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No race events are available yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Organiser</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var raceEvent in Model)
                    {
                        <tr>
                            <td>@raceEvent.EventName</td>
                            <td>@raceEvent.Organiser?.OrganiserName</td>
                            <td>@raceEvent.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@raceEvent.Location</td>
                            <td>@raceEvent.EventType</td>
                            <td>
                                <span class="badge bg-secondary">
                                    @raceEvent.Status
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@raceEvent.EventId"
                                   class="btn btn-outline-primary btn-sm">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
