@model RaceDay.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-4">
    <h1>Delete Race Event</h1>

    <div class="alert alert-warning mt-3">
        Are you sure you want to delete this event?
        This action cannot be undone.
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h4>@Model.EventName</h4>

            <dl class="row mt-3">
                <dt class="col-sm-3">Event Date</dt>
                <dd class="col-sm-9">
                    @Model.EventDate.ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@Model.Location</dd>

                <dt class="col-sm-3">Event Type</dt>
                <dd class="col-sm-9">@Model.EventType</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>

            <form asp-controller="Events"
                  asp-action="Delete"
                  asp-route-id="@Model.EventId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger">
                    Yes, Delete Event
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.EventId"
                   class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

