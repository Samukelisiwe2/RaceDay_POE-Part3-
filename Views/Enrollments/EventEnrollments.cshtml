@model IEnumerable<RaceDay.Models.Enrollment>

@{
    ViewData["Title"] = "Event Enrolments";
    int eventId = (int)ViewBag.EventId;
}

<div class="container mt-4">

    <h1>Event Enrolments</h1>

    <p class="text-muted">
        Registrations for @ViewBag.EventName
    </p>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No participants have registered for this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Email</th>
                        <th>Category</th>
                        <th>Race Number</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var entry in Model)
                    {
                        <tr>
                            <td>
                                @entry.Participant.FirstName
                                @entry.Participant.LastName
                            </td>

                            <td>@entry.Participant.Email</td>

                            <td>@entry.RaceCategory.CategoryName</td>

                            <td>@entry.RaceNumber</td>

                            <td>
                                @entry.EnrollmentDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                <span class="badge bg-secondary">
                                    @entry.EnrollmentStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <a asp-controller="Events"
       asp-action="Details"
       asp-route-id="@eventId"
       class="btn btn-outline-secondary">
        Back to Event
    </a>

</div>
