@model RaceDay.Models.EnrollmentFormViewModel

@{
    ViewData["Title"] = "Enter Race";
}

<div class="container mt-4">

    <h1>Enter Race</h1>

    <p class="text-muted">
        Register for @Model.EventName
    </p>

    <div class="card shadow-sm mt-3">
        <div class="card-body">

            <form asp-controller="Enrollments"
                  asp-action="Create"
                  asp-route-eventId="@Model.EventId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CategoryId"
                           class="form-label"></label>

                    <select asp-for="CategoryId"
                            asp-items="ViewBag.Categories"
                            class="form-select">
                        <option value="0">
                            -- Select Race Category --
                        </option>
                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger"></span>
                </div>

                <div class="alert alert-info">
                    Your race number will be generated
                    automatically after registration.
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Confirm Race Entry
                </button>

                <a asp-controller="Events"
                   asp-action="Details"
                   asp-route-id="@Model.EventId"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
