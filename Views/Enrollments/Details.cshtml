@model RaceDay.Models.Event

@{
    ViewData["Title"] = "Event Details";

    bool isOrganiser = User.IsInRole("Organiser");
    bool isParticipant = User.IsInRole("Participant");

    bool registrationOpen =
        Model.Status == "Open" &&
        Model.ClosingDate.Date >= DateTime.Today;
}

<div class="container mt-4">

    <!-- Event Heading -->
    <h1 class="mb-2">@Model.EventName</h1>

    <p class="text-muted">
        @Model.Description
    </p>

    <!-- Event Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4 class="mb-3">Event Information</h4>

            <dl class="row mb-0">

                <dt class="col-sm-3">Organiser</dt>
                <dd class="col-sm-9">
                    @Model.Organiser?.OrganiserName
                </dd>

                <dt class="col-sm-3">Event Date</dt>
                <dd class="col-sm-9">
                    @Model.EventDate.ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-3">Closing Date</dt>
                <dd class="col-sm-9">
                    @Model.ClosingDate.ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">
                    @Model.Location
                </dd>

                <dt class="col-sm-3">Event Type</dt>
                <dd class="col-sm-9">
                    @Model.EventType
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Status == "Open")
                    {
                        <span class="badge bg-success">Open</span>
                    }
                    else if (Model.Status == "Completed")
                    {
                        <span class="badge bg-primary">Completed</span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <span class="badge bg-danger">Cancelled</span>
                    }
                    else if (Model.Status == "Closed")
                    {
                        <span class="badge bg-warning text-dark">Closed</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    }
                </dd>

            </dl>
        </div>
    </div>

    <!-- Race Categories -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h3 class="mb-0">Race Categories</h3>

        <a asp-controller="RaceCategories"
           asp-action="Index"
           asp-route-eventId="@Model.EventId"
           class="btn btn-outline-primary">
            View Race Categories
        </a>

    </div>

    @if (Model.RaceCategories != null && Model.RaceCategories.Any())
    {
        <div class="table-responsive mb-4">

            <table class="table table-striped align-middle">

                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Entry Fee</th>
                        <th>Participants</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var category in Model.RaceCategories)
                    {
                        <tr>
                            <td>@category.CategoryName</td>

                            <td>
                                @category.DistanceKm.ToString("0.##") km
                            </td>

                            <td>
                                R @category.EntryFee.ToString("N2")
                            </td>

                            <td>
                                @category.CurrentParticipants /
                                @category.MaxParticipants
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info mb-4">
            No race categories have been added yet.
        </div>
    }

    <!-- ======================================== -->
    <!-- PARTICIPANT ACTIONS                      -->
    <!-- ======================================== -->
    @if (isParticipant)
    {
        <div class="mb-3 d-flex flex-wrap gap-2">

            @if (registrationOpen &&
                 Model.RaceCategories != null &&
                 Model.RaceCategories.Any())
            {
                <a asp-controller="Enrollments"
                   asp-action="Create"
                   asp-route-eventId="@Model.EventId"
                   class="btn btn-primary">
                    Enter Race
                </a>
            }
            else
            {
                <span class="text-muted align-self-center">
                    Race registration is currently unavailable.
                </span>
            }

            <a asp-controller="Results"
               asp-action="EventResults"
               asp-route-eventId="@Model.EventId"
               class="btn btn-outline-primary">
                View Race Results
            </a>

            <a asp-controller="Results"
               asp-action="MyResults"
               class="btn btn-outline-secondary">
                My Results
            </a>

        </div>
    }

    <!-- ======================================== -->
    <!-- ORGANISER ACTIONS                        -->
    <!-- ======================================== -->
    @if (isOrganiser)
    {
        <!-- Enrolment and Results Buttons -->
        <div class="mb-3 d-flex flex-wrap gap-2">

            <a asp-controller="Enrollments"
               asp-action="EventEnrollments"
               asp-route-eventId="@Model.EventId"
               class="btn btn-primary">
                View Event Enrolments
            </a>

            <a asp-controller="Results"
               asp-action="EventResults"
               asp-route-eventId="@Model.EventId"
               class="btn btn-outline-primary">
                View Race Results
            </a>

        </div>

        <!-- Event Management Buttons -->
        <div class="mb-3 d-flex flex-wrap gap-2">

            <a asp-controller="Events"
               asp-action="Edit"
               asp-route-id="@Model.EventId"
               class="btn btn-warning">
                Edit Event
            </a>

            <a asp-controller="Events"
               asp-action="Delete"
               asp-route-id="@Model.EventId"
               class="btn btn-danger">
                Delete Event
            </a>

        </div>
    }

    <!-- Back to Events -->
    <div class="mt-3 mb-4">

        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Events
        </a>

    </div>

</div>
