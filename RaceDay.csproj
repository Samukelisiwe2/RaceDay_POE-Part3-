<Project Sdk="Microsoft.NET.Sdk.Web">

	<!-- ====================================== -->
	<!-- 1. PROJECT CONFIGURATION -->
	<!-- ====================================== -->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- ASP.NET Core User Secrets -->
		<UserSecretsId>aspnet-RaceDay-0486d083-8a66-452a-97ff-265f787d0a86</UserSecretsId>

		<!-- Generate XML documentation for Swagger -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Suppress missing XML documentation warnings -->
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<!-- ====================================== -->
	<!-- 2. EXCLUDE TEST PROJECT FILES -->
	<!-- ====================================== -->

	<ItemGroup>
		<!-- Exclude unused ApplicationUser class -->
		<Compile Remove="Data\ApplicationUser.cs" />

		<!-- Prevent the main web project from compiling
         or copying nested test project files -->
		<Compile Remove="RaceDay.Tests\**\*" />
		<EmbeddedResource Remove="RaceDay.Tests\**\*" />
		<None Remove="RaceDay.Tests\**\*" />
		<Content Remove="RaceDay.Tests\**\*" />
	</ItemGroup>

	<!-- ====================================== -->
	<!-- 3. NUGET PACKAGES -->
	<!-- ====================================== -->

	<ItemGroup>

		<PackageReference
		  Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore"
		  Version="10.0.13" />

		<PackageReference
		  Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore"
		  Version="10.0.13" />

		<PackageReference
		  Include="Microsoft.AspNetCore.Identity.UI"
		  Version="10.0.13" />

		<PackageReference
		  Include="Microsoft.EntityFrameworkCore.SqlServer"
		  Version="10.0.13" />

		<PackageReference
		  Include="Microsoft.EntityFrameworkCore.Design"
		  Version="10.0.13"
		  PrivateAssets="all" />

		<PackageReference
		  Include="Microsoft.EntityFrameworkCore.Tools"
		  Version="10.0.13">
			<IncludeAssets>
				runtime; build; native; contentfiles; analyzers; buildtransitive
			</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<PackageReference
		  Include="Swashbuckle.AspNetCore"
		  Version="10.3.0" />

		<PackageReference
		  Include="System.Security.Cryptography.Pkcs"
		  Version="9.0.21" />

	</ItemGroup>



<ItemGroup>
	<Compile Remove="RaceDay.Part3\**\*.cs" />
	<Content Remove="RaceDay.Part3\**\*" />
	<EmbeddedResource Remove="RaceDay.Part3\**\*" />
	<None Remove="RaceDay.Part3\**\*" />
</ItemGroup>
</Project>
